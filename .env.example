# Copy to .env and fill in. Never commit .env.
# Values here are placeholders only — no real credentials.

# --- Application ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/architecture_to_code

# --- LLM ---
# Generic key used by the LLM layer. Provider-specific configuration
# (base URLs, model names, additional providers) will be added to this file
# when the LLM integration is actually implemented.
LLM_API_KEY=
LLM_MODEL=

# --- GitHub integration ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# --- Security ---
# Secret used to sign application sessions / tokens.
APP_SECRET=
